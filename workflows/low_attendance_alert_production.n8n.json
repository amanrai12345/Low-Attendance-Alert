    {
      "parameters": {
        "jsCode": "// Calculates attendance % from sheet rows and picks who should get a message\nconst cfg = $('Config').first().json;\nconst threshold = Number(cfg.threshold);\nconst minDays = Number(cfg.minDays);\nconst gap = Number(cfg.repeatEveryDays);\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' }); // YYYY-MM-DD\n\nconst toISO = (s) => {\n  s = String(s ?? '').trim();\n  let m;\n  if ((m = s.match(/^(\\d{4})-(\\d{1,2})-(\\d{1,2})/))) return `${m[1]}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}`;\n  if ((m = s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})/))) return `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;\n  return '';\n};\n\nconst out = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const keys = Object.keys(row);\n  const find = (s) => keys.find(k => k.trim().toLowerCase().includes(s));\n  const nameK = find('name'), contactK = find('contact'), lastK = find('last alert');\n\n  // Count P / A (new date columns are counted automatically)\n  let p = 0, a = 0;\n  for (const k of keys) {\n    const v = String(row[k] ?? '').trim().toUpperCase();\n    if (v === 'P') p++;\n    else if (v === 'A') a++;\n  }\n  const total = p + a;\n  if (total < minDays) continue;                       // too few days of data, no alert yet\n  const pct = Math.round((p / total) * 1000) / 10;\n  if (pct >= threshold) continue;                      // attendance is fine\n\n  // how many days ago the last alert went out\n  const last = toISO(lastK ? row[lastK] : '');\n  if (last && (Date.parse(today) - Date.parse(last)) / 86400000 < gap) continue;\n\n  // clean phone number -> 91XXXXXXXXXX\n  let digits = String(row[contactK] ?? '').replace(/\\.0+$/, '').replace(/\\D/g, '');\n  if (digits.length > 10) digits = digits.slice(-10);\n  const valid = /^[6-9]\\d{9}$/.test(digits);\n\n  out.push({ json: {\n    row_number: row.row_number,\n    name: String(row[nameK] ?? '').trim(),\n    phone: valid ? '91' + digits : '',\n    valid, pct, today\n  } });\n}\nreturn out;"
      },
