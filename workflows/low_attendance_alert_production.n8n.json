    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Config').first().json.phoneNumberId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Config').first().json.mode === 'template' ? {\n  messaging_product: 'whatsapp',\n  to: $json.phone,\n  type: 'template',\n  template: {\n    name: $('Config').first().json.templateName,\n    language: { code: $('Config').first().json.languageCode },\n    components: [{ type: 'body', parameters: [\n      { type: 'text', text: $json.name },\n      { type: 'text', text: $json.pct + '%' }\n    ] }]\n  }\n} : {\n  messaging_product: 'whatsapp',\n  to: $json.phone,\n  type: 'text',\n  text: { body: 'Low attendance alert: ' + $json.name + ' - attendance ' + $json.pct + '% (below ' + $('Config').first().json.threshold + '%). Please contact the institute.' }\n}) }}",
        "options": {}
      },
      "id": "n7",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "WhatsApp Meta Token"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Reads the WhatsApp API response and builds the status for the sheet\nconst r = $input.item.json;\nconst src = $('Valid number?').item.json;\nconst ok = !!(r.messages && r.messages[0] && r.messages[0].id);\nlet code = '';\nif (!ok) {\n  const m = String((r.error && r.error.message) || '');\n  const a = m.match(/#(\\d+)/) || m.match(/\"code\\\\*\":(\\d+)/);\n  code = a ? a[1] : 'unknown';\n}\nconst hints = {\n  '131030': 'number not in allowed list (test mode)',\n  '132001': 'template not found',\n  '132000': 'template variables wrong',\n  '190': 'token expired',\n  '131047': '24-hour window closed',\n  '131026': 'number not on WhatsApp',\n  '131056': 'too many messages, retry later'\n};\nreturn { json: {\n  row_number: src.row_number,\n  ok,\n  today: src.today,\n  status: ok ? 'Sent ' + src.today : 'Failed ' + code + (hints[code] ? ' - ' + hints[code] : '')\n} };"
      },
