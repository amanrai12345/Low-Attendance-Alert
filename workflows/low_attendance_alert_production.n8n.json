{
  "name": "Low Attendance WhatsApp Alert (Production)",
  "nodes": [
    {
      "parameters": {
        "content": "SETUP (one-time)\n1. Config node: fill in sheetId and phoneNumberId.\n2. Credentials: Google Sheets OAuth2 + Header Auth (Name: Authorization, Value: Bearer <PERMANENT TOKEN>).\n3. Add two plain-text columns at the end of the sheet: 'Last Alert Date' and 'Alert Status'.\n4. Check with Manual Test, then Publish.\n\nConfig guide: threshold = alert when attendance is below this % | minDays = minimum days of data required before alerting | repeatEveryDays = how often (in days) the same parent can be alerted (1 = daily) | mode: template (live) or text (testing only)",
        "height": 300,
        "width": 520
      },
      "id": "s1",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -380
      ]
    },
